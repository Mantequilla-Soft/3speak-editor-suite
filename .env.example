# HLS target resolution height (e.g. 480 for 480p, 720 for 720p)
VITE_HLS_TARGET_RESOLUTION=480

# Enable optional services (comma-separated): frontend,gateway
# Leave empty or remove to run backend only
COMPOSE_PROFILES=

# Backend configuration
MAX_CONCURRENT_JOBS=2

# Gateway URL for the frontend to route render requests through
# Leave empty to render directly on the local backend
VITE_GATEWAY_URL=https://editor-gateway.example.com

# Gateway configuration
GATEWAY_MONGODB_URI=mongodb://user:password@host:27017/dbname
MAX_JOBS_PER_BACKEND=2
HEALTH_CHECK_INTERVAL=15000

# Gateway admin credentials (leave password empty to disable auth)
GATEWAY_ADMIN_USER=admin
GATEWAY_ADMIN_PASSWORD=changeme
